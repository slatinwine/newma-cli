{
  "name": "newma-cli",
  "version": "3.5.1",
  "type": "module",
  "description": "Newma (牛码) - AI-driven code assistant with planning → search → execute → verify loop.",
  "main": "dist/index.js",
  "bin": {
    "newma": "./dist/cli.js",
    "牛码": "./dist/cli.js",
    "newma-create-plugin": "./dist/bin/create-plugin.js"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc --project tsconfig.ui.json && tsc && node scripts/fix-dist-imports.mjs && npm run copy:prompts && npm run copy:templates",
    "build:bun": "bun run build.ts",
    "copy:prompts": "node -e \"const fs=require('fs');fs.mkdirSync('dist/prompts',{recursive:true});for(const f of fs.readdirSync('prompts'))if(f.endsWith('.md'))fs.copyFileSync('prompts/'+f,'dist/prompts/'+f)\"",
    "copy:templates": "node -e \"const fs=require('fs');fs.mkdirSync('dist/skills-creator/templates',{recursive:true});const s='src/skills-creator/templates';if(fs.existsSync(s))for(const f of fs.readdirSync(s))fs.copyFileSync(s+'/'+f,'dist/skills-creator/templates/'+f)\"",
    "dev": "ts-node src/cli.ts",
    "dev:bun": "bun src/cli.ts",
    "daemon": "ts-node src/daemon.ts",
    "daemon:prod": "node dist/daemon.js",
    "init-settings": "ts-node scripts/init-settings.ts",
    "prepublishOnly": "npm run build",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "test:watch": "jest --watch",
    "test:event-sources": "jest tests/test-event-source-manager.test.ts",
    "plugin:load": "bun scripts/load-plugin.ts",
    "benchmark:task-tracker": "node bench/benchmark-task-tracker-v2.ts",
    "benchmark:consolidation": "./bench/benchmark-consolidation.sh",
    "benchmark": "npm run benchmark:task-tracker && npm run benchmark:consolidation",
    "test:consolidation": "./tests/consolidation/test-consolidation.sh && ./tests/consolidation/test-repl-features.sh",
    "verify": "npm run build && npm test && node scripts/verify-smoke.mjs"
  },
  "author": "lijianyi <lijianyi04@126.com>",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.4",
    "@types/cheerio": "^0.22.35",
    "@types/uuid": "^10.0.0",
    "adm-zip": "^0.5.16",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "axios": "^1.13.2",
    "chalk": "^5.3.0",
    "cheerio": "^1.1.2",
    "commander": "^12.1.0",
    "dotenv": "^16.4.5",
    "fast-glob": "^3.3.3",
    "https-proxy-agent": "^9.0.0",
    "ink": "^6.8.0",
    "ink-text-input": "^6.0.0",
    "inquirer": "^9.2.23",
    "node-fetch": "^2.7.0",
    "node-schedule": "^2.1.1",
    "react-devtools-core": "^7.0.1",
    "sharp": "^0.34.5",
    "terminal-markdown": "^0.0.1",
    "uuid": "^13.0.0",
    "ws": "^8.19.0"
  },
  "devDependencies": {
    "@jest/globals": "^30.2.0",
    "@types/adm-zip": "^0.5.7",
    "@types/chokidar": "^1.7.5",
    "@types/inquirer": "^9.0.7",
    "@types/jest": "^30.0.0",
    "@types/js-yaml": "^4.0.9",
    "@types/lru-cache": "^7.10.9",
    "@types/node": "^22.5.1",
    "@types/node-fetch": "^2.6.13",
    "@types/node-schedule": "^2.1.8",
    "@types/react": "^19.2.14",
    "@types/semver": "^7.7.1",
    "@types/tar": "^6.1.13",
    "@types/ws": "^8.18.1",
    "blessed": "^0.1.81",
    "bun-types": "latest",
    "ink-spinner": "^5.0.0",
    "jest": "^30.2.0",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.3"
  },
  "trustedDependencies": [
    "bun-types"
  ]
}
