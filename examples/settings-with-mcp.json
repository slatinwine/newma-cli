{
  "openai": {
    "apiKey": "YOUR_API_KEY_HERE",
    "baseUrl": "https://api.openai.com/v1",
    "model": "gpt-4"
  },
  "project": {
    "enableTools": true,
    "permissionLevel": "standard",
    "enableVerification": false
  },
  "mcp": {
    "enabled": true,
    "servers": {
      "filesystem": {
        "command": "npx",
        "args": [
          "-y",
          "@modelcontextprotocol/server-filesystem",
          "/Users/mac/projects"
        ],
        "transport": "stdio",
        "disabled": false
      },
      "git": {
        "command": "npx",
        "args": [
          "-y",
          "@modelcontextprotocol/server-git",
          "--repository",
          "."
        ],
        "transport": "stdio",
        "disabled": false
      },
      "brave-search": {
        "command": "npx",
        "args": [
          "-y",
          "@modelcontextprotocol/server-brave-search"
        ],
        "transport": "stdio",
        "disabled": true,
        "env": {
          "BRAVE_API_KEY": "YOUR_BRAVE_API_KEY_HERE"
        }
      }
    }
  }
}
