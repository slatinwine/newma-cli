# OpenAI API 配置（智谱 AI 兼容格式）
OPENAI_API_KEY=your-api-key-here
OPENAI_BASE_URL=https://open.bigmodel.cn/api/coding/paas/v4
# 可选：完整的 API 端点（优先级高于 BASE_URL）
# 适用于其他 OpenAI 兼容格式的服务
# OPENAI_ENDPOINT=https://api.openai.com/v1/chat/completions
OPENAI_MODEL=glm-5

# API 兼容性设置
# 如果你的 OpenAI 兼容 API 支持 response_format 参数，设置为 true
# 大多数第三方兼容 API 不支持此参数，保持默认即可
# OPENAI_SUPPORTS_RESPONSE_FORMAT=true

# 重试机制配置（优化稳定性）
# 最大重试次数（默认：3）
RETRY_MAX_ATTEMPTS=3
# 初始重试延迟，单位毫秒（默认：1000）
RETRY_INITIAL_DELAY=1000
# 最大重试延迟，单位毫秒（默认：10000）
RETRY_MAX_DELAY=10000
# 退避乘数，每次重试延迟倍增（默认：2）
RETRY_BACKOFF_MULTIPLIER=2

# 响应缓存配置（优化性能）
# AI 响应缓存已自动启用，缓存时间：10分钟
# 缓存基于 model, messages, temperature, maxTokens 自动失效
# 相同请求在缓存期内会直接返回缓存结果，无需再次调用 API
